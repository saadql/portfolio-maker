// ─── SMALL COMPONENTS ─────────────────────────────────────────────────────────
function Toast({ msg, onDone }) {
  useEffect(() => { const t = setTimeout(onDone, 2600); return () => clearTimeout(t); }, []);
  return <div className="toast" role="status"><div className="toast-dot" />{msg}</div>;
}
function Field({ label, hint, children, col }) {
  return (
    <div className="field" style={col ? { gridColumn: col } : {}}>
      {label && <label>{label}</label>}
      {children}
      {hint && <span className="field-hint">{hint}</span>}
    </div>
  );
}

// ─── STEP 0: BASICS ───────────────────────────────────────────────────────────
function StepBasics({ profile, update, t }) {
  const b = profile.basics;
  const upd = (k, v) => update("basics", { ...b, [k]: v });
  const photoRef = useRef();

  const handlePhoto = (e) => {
    const file = e.target.files[0];
    if (!file) return;
    if (file.size > 2 * 1024 * 1024) { alert("Max 2MB"); return; }
    const reader = new FileReader();
    reader.onload = ev => upd("photo", ev.target.result);
    reader.readAsDataURL(file);
    e.target.value = "";
  };

  return (
    <div className="section-card">
      <h2 className="section-title">👤 {t.steps[0]}</h2>
      <div style={{ marginBottom: 22 }}>
        <div className="photo-upload-zone" onClick={() => !b.photo && photoRef.current?.click()}>
          {b.photo
            ? <img src={b.photo} alt="Profile" className="photo-preview" />
            : <div className="photo-placeholder">📷</div>
          }
          <div className="photo-info">
            <div className="photo-label">{t.photo}</div>
            <div className="photo-sub">{t.photoHint}</div>
            <div className="photo-actions">
              <button className="btn btn-secondary btn-sm" onClick={e => { e.stopPropagation(); photoRef.current?.click(); }}>
                {b.photo ? t.changePhoto : t.uploadPhoto}
              </button>
              {b.photo && (
                <button className="btn btn-danger btn-sm" onClick={e => { e.stopPropagation(); upd("photo", ""); }}>
                  {t.removePhoto}
                </button>
              )}
            </div>
          </div>
        </div>
        <input ref={photoRef} type="file" accept="image/png,image/jpeg,image/webp" style={{ display: "none" }} onChange={handlePhoto} />
      </div>
      <div className="form-grid form-grid-2">
        <Field label={t.fullName}><input value={b.fullName} onChange={e => upd("fullName", e.target.value)} /></Field>
        <Field label={t.title}><input value={b.title} onChange={e => upd("title", e.target.value)} /></Field>
        <Field label={t.email}><input type="email" value={b.email} onChange={e => upd("email", e.target.value)} /></Field>
        <Field label={t.phone}><input value={b.phone} onChange={e => upd("phone", e.target.value)} /></Field>
        <Field label={t.location}><input value={b.location} onChange={e => upd("location", e.target.value)} /></Field>
        <Field label={t.summary} col="1 / -1" hint={t.summaryHint}>
          <textarea value={b.summary} onChange={e => upd("summary", e.target.value)} rows={4} />
        </Field>
      </div>
    </div>
  );
}

// ─── STEP 1: SOCIAL ───────────────────────────────────────────────────────────
function StepSocial({ profile, update, t }) {
  const s = profile.social;
  const upd = (k, v) => update("social", { ...s, [k]: v });
  const updLink = (i, k, v) => update("social", { ...s, links: s.links.map((l, j) => j === i ? { ...l, [k]: v } : l) });

  const SOCIALS = [
    { key: "linkedin", icon: "in", label: t.linkedin, placeholder: "https://linkedin.com/in/yourname" },
    { key: "github", icon: "⌥", label: t.github, placeholder: "https://github.com/yourname" },
    { key: "portfolio", icon: "🌐", label: t.portfolio, placeholder: "https://yoursite.com" },
    { key: "twitter", icon: "𝕏", label: t.twitter, placeholder: "https://twitter.com/yourname" },
  ];

  return (
    <div className="section-card">
      <h2 className="section-title">🔗 {t.steps[1]}</h2>
      <div className="social-grid">
        {SOCIALS.map(({ key, icon, label, placeholder }) => (
          <Field key={key} label={label}>
            <div className="social-field">
              <span className="social-icon" style={{ fontWeight: 700, fontSize: 13, color: "var(--primary)" }}>{icon}</span>
              <input value={s[key] || ""} onChange={e => upd(key, e.target.value)} placeholder={placeholder} />
            </div>
          </Field>
        ))}
      </div>

      {s.links.length > 0 && <div style={{ marginTop: 20 }}>
        <div className="section-title" style={{ fontSize: 14 }}>➕ {t.otherLink}</div>
        {s.links.map((lk, i) => (
          <div className="list-item" key={lk.id}>
            <div className="list-item-header">
              <span className="list-item-label">{lk.label || `Link ${i + 1}`}</span>
              <button className="btn btn-danger btn-sm" onClick={() => update("social", { ...s, links: s.links.filter((_, j) => j !== i) })}>{t.remove}</button>
            </div>
            <div className="form-grid form-grid-2">
              <Field label={t.linkLabel}><input value={lk.label} onChange={e => updLink(i, "label", e.target.value)} placeholder="e.g. Dribbble" /></Field>
              <Field label={t.linkUrl}><input value={lk.url} onChange={e => updLink(i, "url", e.target.value)} placeholder="https://…" /></Field>
            </div>
          </div>
        ))}
      </div>}

      <div style={{ marginTop: 16 }}>
        <button className="btn btn-ghost" onClick={() => update("social", { ...s, links: [...s.links, newLink()] })}>{t.addLink}</button>
      </div>
    </div>
  );
}


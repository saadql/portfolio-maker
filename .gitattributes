        </div>
      ))}
      <button className="btn btn-ghost" onClick={() => update("projects", [...items, newProject()])}>{t.addProject}</button>
    </div>
  );
}

// ─── STEP 7: TEMPLATE ─────────────────────────────────────────────────────────
const TPL_CONFIG = {
  classic: { headerBg: "linear-gradient(135deg,#1A56DB,#0EA5E9)", sideBg: "#F0F6FF", sideAccent: "#DBEAFE" },
  modern:  { headerBg: "#0D1B3E", sideBg: "#F8FAFF", sideAccent: "#3B82F6" },
  minimal: { headerBg: "#FFF", sideBg: "#F5F8FF", sideAccent: "#1A56DB", textDark: true },
  executive:{ headerBg: "#0A0F1E", sideBg: "#F5F8FF", sideAccent: "#DBEAFE", strip: true },
  creative: { headerBg: "#FFF", sideBg: "#EEF4FF", sideAccent: "#1A56DB", textDark: true, topStrip: true },
};

function TemplateThumbnail({ id }) {
  const c = TPL_CONFIG[id];
  return (
    <div className="template-thumb">
      {c.topStrip && <div style={{ height: 6, background: "linear-gradient(90deg,#1A56DB,#0EA5E9,#06B6D4)", flexShrink: 0 }} />}
      {c.strip && <div style={{ height: 4, background: "linear-gradient(90deg,#1A56DB,#0EA5E9,#7C3AED)", flexShrink: 0 }} />}
      <div className="tpl-bar" style={{ background: c.headerBg, borderBottom: c.textDark ? "2px solid #1A56DB" : "none" }}>
        <div className="tpl-avatar" style={{ background: c.textDark ? "#DBEAFE" : "rgba(255,255,255,0.3)" }} />
        <div>
          <div className="tpl-name-line" style={{ background: c.textDark ? "#0D1B3E" : undefined }} />
          <div className="tpl-sub-line" style={{ marginTop: 3, background: c.textDark ? "#1A56DB" : undefined }} />
        </div>
      </div>
      <div className="tpl-body" style={{ background: "#FFF", flex: 1 }}>
        <div className="tpl-col">
          {[70, 55, 80, 45, 65].map((w, i) => <div key={i} className="tpl-line" style={{ width: `${w}%` }} />)}
        </div>
        <div className="tpl-col" style={{ maxWidth: 52, background: c.sideBg, borderLeft: `2px solid ${c.sideAccent}`, paddingLeft: 4 }}>
          {[60, 80, 50, 70].map((w, i) => <div key={i} className="tpl-line" style={{ width: `${w}%` }} />)}
        </div>
      </div>
    </div>
  );
}

function StepTemplate({ template, setTemplate, t }) {
  const keys = ["classic", "modern", "minimal", "executive", "creative"];
  return (
    <div className="section-card">
      <h2 className="section-title">🎨 {t.steps[7]}</h2>
      <p style={{ fontSize: 13, color: "var(--muted)", marginBottom: 20 }}>{t.templateHint}</p>
      <div className="template-grid">
        {keys.map(key => (
          <div
            key={key}
            className={`template-card${template === key ? " selected" : ""}`}
            onClick={() => setTemplate(key)}
            role="radio" aria-checked={template === key}
            tabIndex={0} onKeyDown={e => e.key === "Enter" && setTemplate(key)}
          >
            <div style={{ position: "relative" }}>
              <TemplateThumbnail id={key} />
              {template === key && <div className="template-selected-badge">✓ Selected</div>}
            </div>
            <div className="template-label">
              <div className="template-name">{t.templates[key].name}</div>
              <div className="template-desc">{t.templates[key].desc}</div>
            </div>
          </div>
        ))}
      </div>
    </div>
  );
}

// ─── RESUME CONTENT HELPERS ───────────────────────────────────────────────────
function ResumeMain({ profile, t }) {
  const { experience, projects, basics } = profile;
  return (
    <>
      {basics.summary && (
        <div className="r-section">
          <div className="r-section-title">Profile</div>
          <div className="r-summary">{basics.summary}</div>
        </div>
      )}
      {experience.length > 0 && (
        <div className="r-section">
          <div className="r-section-title">{t.experience}</div>
          {experience.map(exp => (
            <div className="r-exp-item" key={exp.id}>
              <div className="r-exp-role">{exp.role}</div>
              <div className="r-exp-co">{exp.company}{(exp.start || exp.end) ? ` · ${exp.start}${exp.end ? ` – ${exp.end}` : ""}` : ""}</div>
              {exp.details && <div className="r-exp-detail">{exp.details}</div>}
            </div>
          ))}
        </div>
      )}
      {projects.length > 0 && (
        <div className="r-section">
          <div className="r-section-title">{t.projects}</div>
          {projects.map(pr => (
            <div className="r-project-item" key={pr.id}>
              <div className="r-project-name">{pr.name}</div>
              {pr.description && <div className="r-project-desc">{pr.description}</div>}
              {pr.link && <div className="r-project-link"><a href={pr.link} target="_blank" rel="noreferrer">{pr.link}</a></div>}
            </div>
          ))}
        </div>
      )}
    </>
  );
}

function ResumeSide({ profile, t }) {
  const { education, skills, languages, social } = profile;
  const socialItems = [
    social.linkedin && { icon: "in", url: social.linkedin },
    social.github && { icon: "⌥", url: social.github },
    social.portfolio && { icon: "🌐", url: social.portfolio },
    social.twitter && { icon: "𝕏", url: social.twitter },
    ...(social.links || []).filter(l => l.url).map(l => ({ icon: "🔗", label: l.label, url: l.url })),
  ].filter(Boolean);

  return (
    <>
      {socialItems.length > 0 && (
        <div className="r-section">
          <div className="r-section-title">{t.contact}</div>
          {socialItems.map((s, i) => (
            <div className="r-social-row" key={i}>
              <span style={{ fontSize: 12, fontWeight: 700, color: "#1A56DB" }}>{s.icon}</span>
              <a href={s.url} target="_blank" rel="noreferrer">{s.url.replace(/^https?:\/\//, "")}</a>
            </div>
          ))}
        </div>
      )}
      {education.length > 0 && (
        <div className="r-section">
          <div className="r-section-title">{t.education}</div>
          {education.map(edu => (
            <div className="r-edu-item" key={edu.id}>
              <div className="r-edu-degree">{edu.degree}</div>
              <div className="r-edu-school">{edu.school}{edu.year ? ` · ${edu.year}` : ""}</div>
            </div>
          ))}
        </div>
      )}
      {skills.length > 0 && (
        <div className="r-section">
          <div className="r-section-title">{t.skills}</div>
          {skills.map(sk => (
            <div key={sk.id}>
              <div className="r-skill-row"><span>{sk.name}</span><span style={{ fontSize: 10, color: "#5A6A8A" }}>{sk.level}</span></div>
              <div className="r-skill-bar"><div className="r-skill-fill" style={{ width: `${levelPct[sk.level] || 50}%` }} /></div>
            </div>
          ))}
        </div>
      )}
      {languages.length > 0 && (
        <div className="r-section">
          <div className="r-section-title">{t.languages}</div>
          {languages.map(lg => (
            <div className="r-lang-row" key={lg.id}><span>{lg.name}</span><span style={{ fontSize: 11, color: "#5A6A8A" }}>{lg.level}</span></div>
          ))}
        </div>
      )}
    </>
  );
}

function ResumePreview({ profile, t, template }) {
  const { basics } = profile;
  const tpl = template || "classic";
  const Photo = ({ cls, phCls }) => basics.photo
    ? <img src={basics.photo} alt={basics.fullName} className={cls} />
    : <div className={phCls}>👤</div>;

  return (
    <div className={`resume-preview tpl-${tpl}`}>
      {(tpl === "executive" || tpl === "creative") && <div className="r-accent-strip" />}
      <div className="r-header">
        <Photo cls="r-photo" phCls="r-photo-ph" />
        <div style={{ flex: 1 }}>
          <div className="r-name">{basics.fullName || "Your Name"}</div>
          {basics.title && <div className="r-title-txt">{basics.title}</div>}
          <div className="r-meta">
            {basics.email && <span>✉ {basics.email}</span>}
            {basics.phone && <span>📞 {basics.phone}</span>}
            {basics.location && <span>📍 {basics.location}</span>}
          </div>
        </div>
      </div>
      <div className="r-body">
        <div className="r-main"><ResumeMain profile={profile} t={t} /></div>
        <div className="r-side"><ResumeSide profile={profile} t={t} /></div>
      </div>
    </div>
  );
}

// ─── STEP 8: REVIEW ───────────────────────────────────────────────────────────
function StepReview({ profile, t, template, showToast, importRef }) {
  const isReady = profile.basics.fullName && profile.basics.email;
  const exportJSON = () => {
    const blob = new Blob([JSON.stringify({ profile, template }, null, 2)], { type: "application/json" });
    const url = URL.createObjectURL(blob);
    const a = document.createElement("a");
    a.href = url; a.download = `plux-portfolio-${Date.now()}.json`; a.click();
    URL.revokeObjectURL(url);
    showToast("⬇ JSON downloaded!");
  };
  return (
    <>
      <div className={`status-banner ${isReady ? "status-ok" : "status-warn"}`}>
        {isReady ? "✅" : "⚠️"} {isReady ? t.readyOK : t.readyCheck}
      </div>
      <div className="review-toolbar">
        <button className="btn btn-primary" onClick={() => window.print()}>🖨 {t.exportPDF}</button>
        <button className="btn btn-accent" onClick={exportJSON}>⬇ {t.exportJSON}</button>
        <button className="btn btn-ghost" onClick={() => importRef.current?.click()}>⬆ {t.importJSON}</button>
        <span className="print-note">💡 {t.printNote}</span>
      </div>
      <div className="section-card review-card" style={{ padding: 0, background: "transparent", border: "none", boxShadow: "none" }}>
        <ResumePreview profile={profile} t={t} template={template} />
      </div>
      <div className="privacy-note">🔒 {t.privacyNote}</div>
    </>
  );
}

// ─── MAIN APP ─────────────────────────────────────────────────────────────────
export default function App() {
  const [profile, setProfile] = useState(defaultProfile);
  const [step, setStep] = useState(0);
  const [theme, setTheme] = useState("dark");
  const [lang, setLang] = useState("en");
  const [template, setTemplate] = useState("classic");
  const [toast, setToast] = useState(null);
  const importRef = useRef(null);
  const debounceRef = useRef(null);
  const t = TRANSLATIONS[lang];

  useEffect(() => {
    const vars = THEME_VARS[theme];
    const root = document.getElementById("plux-root") || document.documentElement;
    Object.entries(vars).forEach(([k, v]) => root.style.setProperty(k, v));
    try { localStorage.setItem("plux_theme", theme); } catch {}
  }, [theme]);

  useEffect(() => {
    document.documentElement.setAttribute("dir", lang === "ar" ? "rtl" : "ltr");
    try { localStorage.setItem("plux_lang", lang); } catch {}
  }, [lang]);

  useEffect(() => {
    clearTimeout(debounceRef.current);
    debounceRef.current = setTimeout(() => {
      try { localStorage.setItem("plux_draft", JSON.stringify({ profile, template })); } catch {}
    }, 400);
    return () => clearTimeout(debounceRef.current);
  }, [profile, template]);

  useEffect(() => {
    try {
      const th = localStorage.getItem("plux_theme");
      const lg = localStorage.getItem("plux_lang");
      if (th && THEME_VARS[th]) setTheme(th);
      if (lg && TRANSLATIONS[lg]) setLang(lg);
      const raw = localStorage.getItem("plux_draft");
      if (raw) {
        const saved = JSON.parse(raw);
        const prof = saved.profile || saved;
        if (prof.basics) setProfile(prof);
        if (saved.template) setTemplate(saved.template);
      }
    } catch {}
  }, []);

  const showToast = useCallback((msg) => setToast(msg), []);
  const updateSection = (key, val) => setProfile(p => ({ ...p, [key]: val }));

  const saveDraft = () => {
    try { localStorage.setItem("plux_saved", JSON.stringify({ profile, template })); showToast(t.draftSaved); } catch {}
  };
  const loadDraft = () => {
    try {
      const d = localStorage.getItem("plux_saved");
      if (d) {
        const saved = JSON.parse(d);
        const prof = saved.profile || saved;
        if (prof.basics) setProfile(prof);
        if (saved.template) setTemplate(saved.template);
        showToast(t.draftLoaded);
      }
    } catch {}
  };
  const clearAll = () => {
    if (!window.confirm(t.confirmClear)) return;
    setProfile(defaultProfile()); setStep(0); setTemplate("classic");
    try { localStorage.removeItem("plux_draft"); localStorage.removeItem("plux_saved"); } catch {}
    showToast(t.cleared);
  };
  const handleImport = (e) => {
    const file = e.target.files[0];
    if (!file) return;
    const reader = new FileReader();
    reader.onload = (ev) => {
      try {
        const data = JSON.parse(ev.target.result);
        const prof = data.profile || data;
        if (!prof.basics) throw new Error();
        if (!window.confirm(t.confirmImport)) return;
        setProfile(prof);
        if (data.template) setTemplate(data.template);
        setStep(0); showToast(t.imported);
      } catch { showToast(t.invalidJSON); }
    };
    reader.readAsText(file);
    e.target.value = "";
  };

  const STEPS = [
    <StepBasics profile={profile} update={updateSection} t={t} />,
    <StepSocial profile={profile} update={updateSection} t={t} />,
    <StepExperience profile={profile} update={updateSection} t={t} />,
    <StepEducation profile={profile} update={updateSection} t={t} />,
    <StepSkills profile={profile} update={updateSection} t={t} />,
    <StepLanguages profile={profile} update={updateSection} t={t} />,
    <StepProjects profile={profile} update={updateSection} t={t} />,
    <StepTemplate template={template} setTemplate={setTemplate} t={t} />,
    <StepReview profile={profile} t={t} template={template} showToast={showToast} importRef={importRef} />,
  ];

  const isStepDone = (i) => {
    if (i === 0) return !!(profile.basics.fullName && profile.basics.email);
    if (i === 1) return !!(profile.social?.linkedin || profile.social?.github || profile.social?.portfolio || profile.social?.links?.length);
    if (i === 2) return profile.experience.length > 0;
    if (i === 3) return profile.education.length > 0;
    if (i === 4) return profile.skills.length > 0;
    if (i === 5) return profile.languages.length > 0;
    if (i === 6) return profile.projects.length > 0;
    if (i === 7) return !!template;
    return false;
  };

  return (
    <>
      <style>{css}</style>
      <div id="plux-root">
        <div className="app-wrapper">
          <header className="app-header">
            <div className="app-header-brand">
              <div className="brand-icon">✦</div>
              <div>
                <div className="app-header-title">{t.appTitle}</div>
                <div className="app-header-subtitle">{t.appSubtitle}</div>
              </div>
            </div>
            <div className="header-controls">
              <div className="selector-group">
                {["light","dark","hc"].map(th => (
                  <button key={th} className={`sel-btn${theme===th?" active":""}`} onClick={()=>setTheme(th)}>
                    {th==="light"?"☀":th==="dark"?"🌙":"◑"}
                  </button>
                ))}
              </div>
              <div className="selector-group">
                {["en","fr","ar"].map(l => (
                  <button key={l} className={`sel-btn${lang===l?" active":""}`} onClick={()=>setLang(l)}>{l.toUpperCase()}</button>
                ))}
              </div>
              <button className="btn btn-secondary btn-sm" onClick={saveDraft}>{t.saveDraft}</button>
              <button className="btn btn-secondary btn-sm" onClick={loadDraft}>{t.loadDraft}</button>
              <button className="btn btn-ghost btn-sm" onClick={clearAll}>{t.clearAll}</button>
            </div>
          </header>

          <nav className="stepper-wrap">
            <div className="stepper">
              {t.steps.map((s, i) => (
                <button
                  key={i} aria-current={step===i?"step":undefined}
                  className={`step-btn ${step===i?"active":isStepDone(i)?"done":"inactive"}`}
                  onClick={()=>setStep(i)}
                >
                  {isStepDone(i)&&step!==i?"✓ ":""}{s}
                </button>
              ))}
            </div>
          </nav>

          <div key={step}>{STEPS[step]}</div>

          <div className="step-nav">
            {step > 0
              ? <button className="btn btn-secondary" onClick={()=>setStep(s=>s-1)}>{t.back}</button>
              : <div />
            }
            {step < t.steps.length - 1 &&
              <button className="btn btn-primary" onClick={()=>setStep(s=>s+1)}>{t.next}</button>
            }
          </div>
        </div>

        <input ref={importRef} type="file" accept=".json" style={{display:"none"}} onChange={handleImport} />
        {toast && <Toast msg={toast} onDone={()=>setToast(null)} />}
      </div>
    </>
  );
}
